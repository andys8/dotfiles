#!/usr/bin/env bash
set -euo pipefail

pid=$(ioreg -l -w 0 | grep -oE '"kCGSSessionSecureInputPID"=[1-9][0-9]*' | grep -oE '[0-9]+' | head -1)

if [[ -z "$pid" ]]; then
    echo "No process is holding secure input"
    exit 0
fi

app=$(ps -p "$pid" -o comm= 2>/dev/null || echo "unknown")
echo "Secure input held by PID $pid: $app"

read -r -p "Kill it? [y/N] " confirm
if [[ "$confirm" == y ]]; then
    if kill -9 "$pid" 2>/dev/null; then
        echo "Killed $pid"
    else
        echo "Permission denied for PID $pid ($app)."
        if [[ "$app" == *loginwindow ]]; then
            echo "WARNING: killing loginwindow ends your GUI session (logout)."
            echo "Try locking the screen (ctrl+cmd+q) and logging back in first."
        fi
        echo "Run manually if you're sure: sudo kill -9 $pid"
    fi
fi
