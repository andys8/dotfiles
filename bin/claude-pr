#!/bin/bash
set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") <pr-number|pr-url> <prompt...>" >&2
    exit 1
}

ALL="$*"
ARG="${ALL%%[[:space:]]*}"
PROMPT="${ALL#"$ARG"}"
PROMPT="${PROMPT#"${PROMPT%%[![:space:]]*}"}"

if [ -z "$ARG" ] || [ -z "$PROMPT" ]; then
    usage
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 1
fi

if [[ "$ARG" =~ ^[0-9]+$ ]]; then
    PR_NUMBER="$ARG"
    REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
    PR_URL="https://github.com/$REPO/pull/$PR_NUMBER"
elif [[ "$ARG" =~ ^https?://github\.com/[^/]+/[^/]+/pull/([0-9]+)(/.*)?$ ]]; then
    PR_NUMBER="${BASH_REMATCH[1]}"
    PR_URL="$ARG"
else
    echo "Error: first argument must be a PR number or a GitHub PR URL" >&2
    exit 1
fi

exec wt switch "pr:$PR_NUMBER" --execute claude -- --permission-mode=auto "$PR_URL $PROMPT"
